{
  "name": "short-drama-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "install:all": "npm ci && npm --prefix canvas ci",
    "dev": "node scripts/run-frontends.mjs dev",
    "dev:standard": "vite --host 127.0.0.1",
    "dev:canvas": "npm --prefix canvas run dev --",
    "build": "node scripts/run-frontends.mjs build",
    "build:standard": "tsc --noEmit && vite build",
    "build:canvas": "npm --prefix canvas run build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "typecheck:canvas": "npm --prefix canvas run typecheck",
    "test": "node --test tests/*.test.mjs",
    "test:frontends": "node --test runtime-tests/*.test.mjs",
    "test:canvas": "npm --prefix canvas test",
    "test:e2e:canvas": "npm --prefix canvas run test:e2e --",
    "source:check": "npm --prefix canvas run source:check --",
    "test:e2e": "playwright test",
    "test:performance": "playwright test --config performance.config.ts"
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@xzdarcy/react-timeline-editor": "^1.0.0",
    "antd": "^5.29.3",
    "axios": "^1.20.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "20.19.43",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  }
}
