{
  "name": "short-drama-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "install:all": "npm ci && npm --prefix canvas ci",
    "dev": "node scripts/run-frontends.mjs dev",
    "dev:standard": "vite --host 127.0.0.1",
    "dev:canvas": "npm --prefix canvas run dev --",
    "build": "node scripts/run-frontends.mjs build",
    "build:standard": "tsc --noEmit && vite build",
    "build:canvas": "npm --prefix canvas run build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "typecheck:canvas": "npm --prefix canvas run typecheck",
    "test": "node ../scripts/test.mjs --scope frontend --runner node",
    "test:frontends": "node ../scripts/test.mjs --scope frontend --runner runtime --level runtime --feature shared.runtime",
    "test:canvas": "npm --prefix canvas test --",
    "test:e2e:canvas": "npm --prefix canvas run test:e2e --",
    "source:check": "npm --prefix canvas run source:check --",
    "test:e2e": "node ../scripts/test.mjs --scope frontend --runner playwright --level browser",
    "test:performance": "node ../scripts/test.mjs --scope frontend --runner performance --level performance --feature shared.performance"
  },
  "dependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@ant-design/x": "1.6.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/lang-yaml": "6.1.2",
    "@codemirror/view": "6.39.15",
    "@uiw/react-codemirror": "4.25.11",
    "@xzdarcy/react-timeline-editor": "^1.0.0",
    "antd": "^5.29.3",
    "axios": "^1.20.0",
    "lucide-react": "1.25.0",
    "quill": "2.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "20.19.43",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  }
}
