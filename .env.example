# Optional Docker Compose overrides, read from the repository root.
# These are local development credentials; backend/.env is configured separately.
MYSQL_PORT=3306
MYSQL_DATABASE=short_drama
MYSQL_USER=short_drama
MYSQL_PASSWORD=short_drama_dev
MYSQL_ROOT_PASSWORD=short_drama_root_dev

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=short_drama
RABBITMQ_PASSWORD=short_drama_mq_dev
RABBITMQ_VHOST=/

MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=short_drama
MINIO_ROOT_PASSWORD=short_drama_minio_dev
MINIO_IMAGE_BUCKET=image
MINIO_VIDEO_BUCKET=video
