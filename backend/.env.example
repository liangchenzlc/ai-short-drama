APP_NAME=AI Short Drama
# Enable only after the explicit collaboration migration. Normal deployment requires auth.
AUTH_ENABLED=true
# Local HTTP development only: use false with an exact http://127.0.0.1 origin.
# Production requires HTTPS and secure cookies.
AUTH_COOKIE_SECURE=true
PUBLIC_ORIGIN=https://localhost
AUTH_SESSION_DAYS=7
# Codes are never returned by HTTP. Configure a real SMTP server for registration/invitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Independent random HMAC secret; if empty, falls back to ENCRYPTION_KEY.
EMAIL_PROOF_KEY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=short_drama
DB_PASSWORD=
DB_NAME=short_drama
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT=3
# Base64 encoded 32-byte AES key. Keep outside database and version control.
ENCRYPTION_KEY=
# Unique for every concurrently running backend process (0..1023).
SNOWFLAKE_WORKER_ID=1
# Optional exact host allowlist for model discovery into private networks (JSON array).
# Public destinations require no entry. Keep [] unless an internal gateway is needed.
MODEL_DISCOVERY_ALLOWED_HOSTS=[]
# Existing MinIO server; endpoint excludes http(s)://.
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_REGION=us-east-1
MINIO_IMAGE_BUCKET=image
MINIO_VIDEO_BUCKET=video
MINIO_AUDIO_BUCKET=short-drama-audio
# Enable only after applying the 2026-09-30 migrations and starting new workers.
GENERATION_BATCHES_ENABLED=false
GENERATION_BATCH_IMAGE_CONCURRENCY=2
GENERATION_BATCH_VIDEO_CONCURRENCY=1
AUDIO_PRODUCTION_ENABLED=false
# Apply native_voice_ddl before enabling; requires AUDIO_PRODUCTION_ENABLED and updated workers.
NATIVE_VIDEO_ENABLED=false
GENERATION_AUDIO_BUDGET_SECONDS=300
# API/render workers must share this font for burned subtitles.
# Linux: /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# Windows: C:/Windows/Fonts/msyh.ttc (family: Microsoft YaHei)
RENDER_SUBTITLE_FONT_PATH=
RENDER_SUBTITLE_FONT_FAMILY=Noto Sans CJK SC
MINIO_CONNECT_TIMEOUT=5
MINIO_READ_TIMEOUT=60
MINIO_PRESIGN_EXPIRY=300
# RabbitMQ AMQP connection; 15672 is the management UI, not the broker port.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=short_drama
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_TLS=false
GENERATION_LEASE_SECONDS=120
GENERATION_PUBLISH_LEASE_SECONDS=15
GENERATION_POLL_SECONDS=5
GENERATION_TEXT_BUDGET_SECONDS=3600
GENERATION_IMAGE_BUDGET_SECONDS=300
GENERATION_VIDEO_BUDGET_SECONDS=1800
GENERATION_ARCHIVE_BUDGET_SECONDS=86400
# Text-only script asset extraction; input is rejected rather than silently truncated.
EXTRACTION_MAX_SCRIPT_CHARS=30000
EXTRACTION_MAX_CANDIDATES=100
EXTRACTION_MAX_OUTPUT_TOKENS=8192
# Only needed when running integration tests. Database name must end in _test.
# TEST_DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/short_drama_test
