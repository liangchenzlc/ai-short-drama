                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 800
                  },
                  "evidence": {
                    "type": "array",
                    "maxItems": 4,
                    "items": {
                      "type": "string",
                      "maxLength": 300
                    }
                  },
                  "severity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
