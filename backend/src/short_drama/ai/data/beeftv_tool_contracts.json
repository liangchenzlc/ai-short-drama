                    ]
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "composition",
                      "color",
                      "lighting",
                      "proportion",
                      "other"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 180
                  },
                  "observation": {
                    "type": "string",
                    "maxLength": 600
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 800
                  },
                  "evidence": {
                    "type": "array",
                    "maxItems": 4,
                    "items": {
                      "type": "string",
                      "maxLength": 300
                    }
                  },
                  "severity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "targetDescription": {
                    "type": "string",
                    "maxLength": 300
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "aggregate_art_critique",
        "description": "合并多个 Reviewer 的候选问题，去重、排序并形成可执行的最终问题草案。",
        "strict": true,
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "strengths",
            "issues",
            "options"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "maxLength": 1600
            },
            "strengths": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "issues": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "category",
                  "title",
                  "explanation",
                  "severity",
                  "confidence",
                  "targetDescription",
                  "suggestion",
                  "sourceCandidateIds"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "composition",
                      "color",
                      "lighting",
                      "proportion",
                      "other"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 180
                  },
                  "explanation": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "targetDescription": {
                    "type": "string",
                    "maxLength": 300
                  },
                  "suggestion": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "goal",
                      "actions",
                      "preserve",
                      "expectedEffect"
                    ],
                    "properties": {
                      "goal": {
                        "type": "string",
                        "maxLength": 500
                      },
                      "actions": {
                        "type": "array",
                        "maxItems": 6,
                        "items": {
                          "type": "string",
                          "maxLength": 500
                        }
                      },
                      "preserve": {
                        "type": "array",
                        "maxItems": 6,
                        "items": {
                          "type": "string",
                          "maxLength": 500
                        }
                      },
                      "expectedEffect": {
                        "type": "string",
                        "maxLength": 500
                      }
                    }
                  },
                  "sourceCandidateIds": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "maxLength": 80
                    }
                  }
                }
              }
            },
            "options": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "category",
                  "title",
                  "explanation",
                  "confidence",
                  "suggestion",
                  "sourceCandidateIds"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "composition",
                      "color",
                      "lighting",
                      "proportion",
                      "other"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 180
                  },
                  "explanation": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "suggestion": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "goal",
                      "actions",
                      "preserve",
                      "expectedEffect"
                    ],
                    "properties": {
                      "goal": {
                        "type": "string",
                        "maxLength": 500
                      },
                      "actions": {
                        "type": "array",
                        "maxItems": 6,
                        "items": {
                          "type": "string",
                          "maxLength": 500
                        }
                      },
                      "preserve": {
                        "type": "array",
                        "maxItems": 6,
                        "items": {
                          "type": "string",
                          "maxLength": 500
                        }
                      },
                      "expectedEffect": {
                        "type": "string",
                        "maxLength": 500
                      }
                    }
                  },
                  "sourceCandidateIds": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "maxLength": 80
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "ground_art_critique_issues",
        "description": "只把已有问题绑定到图片区域，不重新评价图片，也不创建新问题。",
        "strict": true,
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targets"
          ],
          "properties": {
            "targets": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "issueId",
                  "target",
                  "groundingConfidence"
                ],
                "properties": {
                  "issueId": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "target": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "points"
                    ],
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "box",
                          "point",
                          "points",
                          "polygon",
                          "global"
                        ]
                      },
                      "points": {
                        "type": "array",
                        "maxItems": 12,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "x",
                            "y"
                          ],
                          "properties": {
                            "x": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "y": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          }
                        }
                      }
                    }
                  },
                  "groundingConfidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "generate_art_edit_prompts",
        "description": "根据已有问题和已定位区域，为每个问题生成可直接用于局部图像编辑的 AI 提示词；不得创建新问题。",
        "strict": true,
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompts"
          ],
          "properties": {
            "prompts": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "issueId",
                  "editPrompt"
                ],
                "properties": {
                  "issueId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "editPrompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2400
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "verify_art_critique",
        "description": "作为没有参与前面判断的复核者，逐项确认已有问题和位置是否有图像证据。不得新增问题。",
        "strict": true,
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decisions"
          ],
          "properties": {
            "decisions": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "issueId",
                  "verdict",
                  "confidence",
                  "reason"
                ],
                "properties": {
                  "issueId": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "verdict": {
                    "type": "string",
                    "enum": [
                      "confirmed",
                      "uncertain",
                      "rejected"
                    ]
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
