          "required": [
            "candidates"
          ],
          "properties": {
            "candidates": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "checkId",
                  "kind",
                  "category",
                  "title",
                  "observation",
                  "reason",
                  "evidence",
                  "severity",
                  "confidence",
