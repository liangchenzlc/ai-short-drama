                    ]
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 180
                  },
                  "observation": {
                    "type": "string",
                    "maxLength": 600
                  },
                  "reason": {
                    "type": "string",
                    "maxLength": 800
                  },
                  "evidence": {
                    "type": "array",
                    "maxItems": 4,
                    "items": {
                      "type": "string",
                      "maxLength": 300
                    }
                  },
                  "severity": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "targetDescription": {
                    "type": "string",
                    "maxLength": 300
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "review_art_structure",
        "description": "只检查结构、比例、透视和细节一致性，提交有证据的候选问题；允许返回空候选。",
        "strict": true,
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidates"
          ],
          "properties": {
            "candidates": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "checkId",
                  "kind",
                  "category",
                  "title",
                  "observation",
                  "reason",
                  "evidence",
                  "severity",
                  "confidence",
                  "targetDescription"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "checkId": {
                    "type": "string",
